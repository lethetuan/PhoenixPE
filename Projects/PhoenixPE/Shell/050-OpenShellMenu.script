[Main]
Title=Open-Shell Menu
Description=(v4.4.198) Open-Shell Menu is the premier Open-Source Start Menu replacement.
Author=Homes32
Level=3
Selected=False
Mandatory=False
Version=1.6.6.0
Date=2026-06-07

[Variables]
%ProgramFolder%="Open-Shell"
%ProgramVersion%="4_4_198"
%SetupExe%="OpenShellSetup_%ProgramVersion%.exe"
%SetupFilex86%="OpenShellSetup32_%ProgramVersion%.msi"
%SetupFilex64%="OpenShellSetup64_%ProgramVersion%.msi"

[Process]
Echo,"Configuring [ Open-Shell ] as the start menu..."
RunFromRAM

If,%SourceVer%,Bigger,10.0.26100.0,Halt,"Open-Shell does not currently work with Win11 24H2 and later sources. Please enable the StartAllBack script instead."

Run,%ScriptFile%,ExtractProgram
ExtractAllFiles,%ScriptFile%,CustomBtn,"%TargetDir%\Program Files\%ProgramFolder%"

// For Pins - Must exist before PinUtil runs or pins won't be created.
DirMake,"%TargetDir%\Users\Default\AppData\Roaming\OpenShell\Pinned"

Echo,"Preparing Registry Hives..."
ExtractAllFiles,%ScriptFile%,Reg,"%ProjectTemp%\%ProgramFolder%"

If,%cb_UseCustomXMLCfg%,Equal,True,Begin
  If,Not,ExistFile,%fb_CustomXMLCfg%,Halt,"Error: The specified XML configuration file does not exist!"
  StrFormat,EXT,%fb_CustomXMLCfg%,%FileExt%
  If,Not,%FileExt%,Equal,".xml",Halt,"Error: The configuration file must be an .XML file!"
  Set,%FileExt%,Nil  
  FileCopy,%fb_CustomXMLCfg%,"%TargetDir%\Program Files\Open-Shell\MenuSettings.xml"
  AddAutoRun,PreShell,HideWait,"Configuring Open-Shell Menu...","#$q#$pProgramFiles#$p\Open-Shell\StartMenu.exe#$q","-xml #$q#$pProgramFiles#$p\Open-Shell\MenuSettings.xml#$q"
End

RegHiveLoad,Tmp_Software,%RegSoftware%
RegHiveLoad,Tmp_Default,%RegDefault%

Echo,"Configuring Start Menu..."

///////////////////////////////////////////////////////////////////////////////////
// Default Open-Shell Config
RegImport,"%ProjectTemp%\%ProgramFolder%\OpenShell-RegDefault.reg"
RegImport,"%ProjectTemp%\%ProgramFolder%\OpenShell-RegSoftware-%SourceArch%.reg"

///////////////////////////////////////////////////////////////////////////////////
// User Defined Open-Shell Options
Run,%ScriptFile%,UserConfig

RegHiveUnload,Tmp_Software
RegHiveUnload,Tmp_Default

[#ExtractProgram#]
// ===============================================================================================================================
// Name...........: ExtractProgram
// Description....: Extract program files from script/setup files.
// Syntax.........: Run,%ScriptFile%,ExtractProgram
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: OpenShell bundles it's .msi installers inside a custom setup .exe so we need to extract the .msi files first.
//                  The developers were kind enough to give us the extract32 and extract64 cmd line arguments to accomplish this,
//                  so after we free the .msi files we can extract them with lessmsi and copy the files to our program folder.
// Related........: 
// ===============================================================================================================================
[ExtractProgram]
Echo,"Extracting files..."

// MSI Extract doesn't overwrite, its appends .duplicate? so we need to make sure our target is clean
DirDeleteEx,"%ProjectTemp%\%ProgramFolder%"

ExtractFile,%ScriptFile%,Open-Shell,%SetupExe%,"%ProjectTemp%\%ProgramFolder%"

Echo,"Extracting [%SourceArch%] .msi file..."
If,%SourceArch%,Equal,x64,Begin
  ShellExecute,Hide,"%ProjectTemp%\%ProgramFolder%\%SetupExe%","extract64","%ProjectTemp%\%ProgramFolder%"
  Set,%SetupFile%,%SetupFilex64%
End
Else,Begin
  ShellExecute,Hide,"%ProjectTemp%\%ProgramFolder%\%SetupExe%","extract32","%ProjectTemp%\%ProgramFolder%"
  Set,%SetupFile%,%SetupFilex86%
End

Echo,"Extracting program files..."
MSIExtract,"%ProjectTemp%\%ProgramFolder%\%SetupFile%","%ProjectTemp%\%ProgramFolder%"

// StartMenuHelper
If,%SourceArch%,Equal,x64,Begin
  FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\StartMenuHelper64.dll",%TargetSystem32%
  FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\StartMenuHelper32.dll","%TargetWindows%\SysWOW64"
End  
Else,FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\StartMenuHelper32.dll",%TargetSystem32%

// Program Files
FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\PFiles\Open-Shell\Skins\*.*","%TargetPrograms%\%ProgramFolder%\Skins\"
FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\PFiles\Open-Shell\OpenShell*.*","%TargetPrograms%\%ProgramFolder%\"
FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\PFiles\Open-Shell\StartMenu*.*","%TargetPrograms%\%ProgramFolder%\"

[#UserConfig#]
// ===============================================================================================================================
// Name...........: UserConfig
// Description....: Configure settings defined by the script interface.
// Syntax.........: Run,%ScriptFile%,UserConfig
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: 
// ===============================================================================================================================
[UserConfig]

// Language
StrFormat,SPLIT,%cmb_Language%,"[",2,%Lang%
StrFormat,RTRIM,%Lang%,1,%Lang%
RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\OpenShell\Settings","Language",%Lang%

// Menu Style & Skin
If,%cmb_MenuStyle%,Equal,"Windows 7",Begin
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuStyle","Win7"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","SkinW7",%cmb_MenuSkinWin7%
End
Else,If,%cmb_MenuStyle%,Equal,"Classic 1 Column",Begin
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuStyle","Classic1"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","SkinC1",%cmb_MenuSkinC1%
End
Else,If,%cmb_MenuStyle%,Equal,"Classic 2 Column",Begin
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuStyle","Classic2"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","SkinC2",%cmb_MenuSkinC2%
End
Else,Halt,"INTERNAL LOGIC ERROR: No configuration defined for Menu Style [%cmb_MenuStyle%]"

// Menu Button
If,%cmb_MenuBtn%,Equal,"Default",Begin
  If,%Shell%,Equal,"WinXShell",Begin
    RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
    RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
    RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","#$pSystemDrive#$p\Program Files\%ProgramFolder%\Win10.png"
  End
  Else,RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",0
End  
Else,If,%cmb_MenuBtn%,Equal,"Aero",Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","AeroButton"
End
Else,If,%cmb_MenuBtn%,Equal,"Classic",Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","ClasicButton"
End
Else,If,%cmb_MenuBtn%,Equal,"CoolBlu",Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","#$pSystemDrive#$p\Program Files\%ProgramFolder%\CoolBlu.png"
End
Else,If,%cmb_MenuBtn%,Equal,"TruOrb",Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","#$pSystemDrive#$p\Program Files\%ProgramFolder%\TruOrb.png"
End
Else,If,%cmb_MenuBtn%,Equal,"Win8Pro",Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","#$pSystemDrive#$p\Program Files\%ProgramFolder%\Win8Pro.png"
End
Else,If,%cmb_MenuBtn%,Equal,"Win10",Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","#$pSystemDrive#$p\Program Files\%ProgramFolder%\Win10.png"
End
Else,If,%cmb_MenuBtn%,Equal,"Win11",Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","#$pSystemDrive#$p\Program Files\%ProgramFolder%\Win11.png"
End
Else,If,%cmb_MenuBtn%,Equal,"Custom",Begin
  Set,%SupportedImagesList%,".bmp|.png"

  If,Not,ExistFile,%fb_StartButtonImage%,Halt,"Error: The specified Start Button Custom Image file [%fb_StartButtonImage%] does not exist!"

  StrFormat,Ext,%fb_StartButtonImage%,%ImgExt%

  List,Pos,%SupportedImagesList%,%ImgExt%,%IsSupportedImage%
  If,%IsSupportedImage%,Equal,0,Halt,"Error: Open-Shell Menu requires menu button images to be [%SupportedImagesList%]."

  FileCopy,%fb_StartButtonImage%,"%TargetDir%\Program Files\Open-Shell\CustomBtn%ImgExt%"

  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
  RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","#$pSystemDrive#$p\Program Files\%ProgramFolder%\CustomBtn%ImgExt%"
End
Else,Halt,"INTERNAL LOGIC ERROR: No configuration defined for Start Button [%cmb_MenuBtn%]"

// User Account Picture
If,%cb_ShowUserPic%,Equal,True,Set,%ShowUserPic%,1
Else,Set,%ShowUserPic%,0
RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","UserPicturePath","#$pALLUSERSPROFILE#$p\Microsoft\User Account Pictures\user-192.png"

// Taskbar Transparency
RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","CustomTaskbar",1
RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","TaskbarLook",%cmb_TaskbarLook%

// Small menu icons
If,%cb_UseSmallIcons%,Equal,True,Set,%UseSmallIcons%,1
Else,Set,%UseSmallIcons%,0

// Large font
If,%cb_UseLargeFonts%,Equal,True,Set,%UseLargeFonts%,1
Else,Set,%UseLargeFonts%,0

// Display folders before items
If,%cb_SortFoldersFirst%,Equal,True,RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","FoldersFirst",1
Else,RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","FoldersFirst",0

// Fly-out menu (Windows XP style)
If,%cb_FlyoutMenu%,Equal,True,RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","ProgramsStyle","Cascade"
Else,RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","ProgramsStyle","Inline"

// White menu background
If,%cb_WhiteSubMenus%,Equal,True,Set,%WhiteSubMenus%,1
Else,Set,%WhiteSubMenus%,0

// Menu Transparency
If,%cb_MakeMenuOpaque%,Equal,True,Set,%MakeMenuOpaque%,1
Else,Set,%MakeMenuOpaque%,0

// Show search in menu
If,%cb_ShowSearch%,Equal,True,RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","SearchBox","Normal"
Else,RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","SearchBox","Hide"

// Number of recent programs to display
RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MaxRecentPrograms",%nb_MaxRecentPgm%

// Write SkinOptionsW7
// Options that don't pertain to the selected skin will be ignored so we can be lazy and leave them in the config.
RegWrite,HKLM,REG_MULTI_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","SkinOptionsW7","USER_IMAGE=%ShowUserPic%","SMALL_ICONS=%UseSmallIcons%","LARGE_FONT=%UseLargeFonts%","OPAQUE=%MakeMenuOpaque%","WHITE_SUBMENUS=%WhiteSubMenus%","ICON_FRAMES=0"

// Debug Log
If,%cb_DebugLog%,Equal,True,Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","LogCategories",4095
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","LogStartup",1
End  
Else,Begin
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","LogCategories",0
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","LogStartup",0
End  

///////////////////////////////////////////////////////////////////////////////////
// Custom Commands

// Open-Shell default items go to 24 so we start at #25. Not really needed, but keeps the defaults available.
// Note: This will not remove existing entries if the Item is disabled. Shell level scripts are not designed for post-build tweaking.
If,%cb_Custom_Item1_Enabled%,Equal,True,Begin
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item25.Command=%txt_Custom_Item1_Cmd%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item25.Label=%txt_Custom_Item1_Label%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item25.Settings=NOEXPAND"
End
If,%cb_Custom_Item2_Enabled%,Equal,True,Begin
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item26.Command=%txt_Custom_Item2_Cmd%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item26.Label=%txt_Custom_Item2_Label%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item26.Settings=NOEXPAND"
End
If,%cb_Custom_Item3_Enabled%,Equal,True,Begin
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item27.Command=%txt_Custom_Item3_Cmd%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item27.Label=%txt_Custom_Item3_Label%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item27.Settings=NOEXPAND"
End
If,%cb_Custom_Item4_Enabled%,Equal,True,Begin
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item28.Command=%txt_Custom_Item4_Cmd%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item28.Label=%txt_Custom_Item4_Label%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item28.Settings=NOEXPAND"
End
If,%cb_Custom_Item5_Enabled%,Equal,True,Begin
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item29.Command=%txt_Custom_Item5_Cmd%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item29.Label=%txt_Custom_Item5_Label%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item29.Settings=NOEXPAND"
End
If,%cb_Custom_Item6_Enabled%,Equal,True,Begin
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item30.Command=%txt_Custom_Item6_Cmd%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item30.Label=%txt_Custom_Item6_Label%"
  RegMulti,HKLM,"Tmp_Default\Software\OpenShell\StartMenu\Settings","MenuItems7",APPEND,"Item30.Settings=NOEXPAND"
End

[#SwitchStartMenuStyle#]
// ===============================================================================================================================
// Name...........: SwitchStartMenuStyle
// Description....: Show/Hide the configuration options based on the configured Menu Style.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: cmb_MenuStyle
// ===============================================================================================================================
[SwitchStartMenuStyle]
If,%cmb_MenuStyle%,Equal,"Windows 7",Begin
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinC1,False
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinC2,False
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinWin7,True
End
Else,If,%cmb_MenuStyle%,Equal,"Classic 1 Column",Begin
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinC1,True
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinC2,False
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinWin7,False
End
Else,If,%cmb_MenuStyle%,Equal,"Classic 2 Column",Begin
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinC1,False
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinC2,True
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_MenuSkinWin7,False
End
Else,Halt,"INTERNAL LOGIC ERROR: No configuration defined for Menu Style [%cmb_MenuStyle%]"

[#ToggleCustomImgFilebox#]
// ===============================================================================================================================
// Name...........: ToggleCustomImgFilebox
// Description....: Show/Hide the filebox used for including a custom start menu button image.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: cmb_MenuBtn
// ===============================================================================================================================
[ToggleCustomImgFilebox]
If,%cmb_MenuBtn%,Equal,"Custom",Begin
  WriteInterface,Visible,%ScriptFile%,Interface,lbl_CustomImage,True
  WriteInterface,Visible,%ScriptFile%,Interface,fb_StartButtonImage,True
End
Else,Begin
  WriteInterface,Visible,%ScriptFile%,Interface,lbl_CustomImage,False
  WriteInterface,Visible,%ScriptFile%,Interface,fb_StartButtonImage,False
End

[#SetDefaultOptions#]
// ===============================================================================================================================
// Name...........: SetDefaultOptions
// Description....: Sets script options to default values.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: 
// Related........: btn_SetDefaultOptions
// ===============================================================================================================================
[SetDefaultOptions]
System,Cursor,Wait
WriteInterface,Value,%ScriptFile%,Interface,cmb_Language,"English [en-US]"
WriteInterface,Value,%ScriptFile%,Interface,cmb_MenuStyle,"Windows 7"
Run,%ScriptFile%,SwitchStartMenuStyle
WriteInterface,Value,%ScriptFile%,Interface,cmb_MenuSkinC1,Metro
WriteInterface,Value,%ScriptFile%,Interface,cmb_MenuSkinC2,Metro
WriteInterface,Value,%ScriptFile%,Interface,cmb_MenuSkinWin7,Metro
WriteInterface,Value,%ScriptFile%,Interface,cmb_MenuBtn,Default
Run,%ScriptFile%,ToggleCustomImgFilebox
WriteInterface,Value,%ScriptFile%,Interface,fb_StartButtonImage,""
WriteInterface,Value,%ScriptFile%,Interface,cmb_TaskbarLook,Glass
WriteInterface,Value,%ScriptFile%,Interface,cb_ShowUserPic,False
WriteInterface,Value,%ScriptFile%,Interface,cb_UseSmallIcons,False
WriteInterface,Value,%ScriptFile%,Interface,cb_UseLargeFonts,False
WriteInterface,Value,%ScriptFile%,Interface,cb_SortFoldersFirst,False
WriteInterface,Value,%ScriptFile%,Interface,cb_FlyoutMenu,False
WriteInterface,Value,%ScriptFile%,Interface,cb_WhiteSubMenus,False
WriteInterface,Value,%ScriptFile%,Interface,cb_MakeMenuOpaque,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ShowSearch,True
WriteInterface,Value,%ScriptFile%,Interface,nb_MaxRecentPgm,20
WriteInterface,Value,%ScriptFile%,Interface,cb_UseCustomXMLCfg,False
WriteInterface,Value,%ScriptFile%,Interface,cb_DebugLog,False
WriteInterface,Value,%ScriptFile%,Interface,fb_CustomXMLCfg,""
WriteInterface,Value,%ScriptFile%,Interface,cb_Custom_Item1_Enabled,False
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item1_Cmd,"SEPARATOR"
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item1_Label,""
WriteInterface,Value,%ScriptFile%,Interface,cb_Custom_Item2_Enabled,False
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item2_Cmd,"Downloads"
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item2_Label,""
WriteInterface,Value,%ScriptFile%,Interface,cb_Custom_Item3_Enabled,False
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item3_Cmd,"Network"
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item3_Label,""
WriteInterface,Value,%ScriptFile%,Interface,cb_Custom_Item4_Enabled,False
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item4_Cmd,"Network_Connections"
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item4_Label,""
WriteInterface,Value,%ScriptFile%,Interface,cb_Custom_Item5_Enabled,False
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item5_Cmd,"Devices"
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item5_Label,""
WriteInterface,Value,%ScriptFile%,Interface,cb_Custom_Item6_Enabled,False
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item6_Cmd,"cmd.exe"
WriteInterface,Value,%ScriptFile%,Interface,txt_Custom_Item6_Label,"Command Prompt"

System,Cursor,Normal

[#ToggleAdvancedOptions#]
// ===============================================================================================================================
// Name...........: ToggleAdvancedOptions
// Description....: Show/Hide advanced options in the script interface.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_AdvancedOptions
// ===============================================================================================================================
[ToggleAdvancedOptions]
System,SetLocal
ReadInterface,Visible,%ScriptFile%,Interface,bvl_AdvancedOptions,%state%
If,%state%,Equal,False,Begin
  If,Question,"WARNING!#$x#$xAdvanced options are intended for expert users only!#$x#$xModifying advanced options without knowing what you are doing can cause permanent damage to your project and may result in unexpected behavior and/or build failures.#$x#$xAre you sure you want to continue?",Begin
	Set,%Toggle%,True
    WriteInterface,Resource,%ScriptFile%,Interface,btn_AdvancedOptions,Advanced_Exit_16.png
	WriteInterface,Tooltip,%ScriptFile%,Interface,btn_AdvancedOptions,"Hide Advanced Options"
  End
  Else,Set,%Toggle%,False
End
Else,Begin
  Set,%Toggle%,False
  WriteInterface,Resource,%ScriptFile%,Interface,btn_AdvancedOptions,Advanced_16.png
  WriteInterface,Tooltip,%ScriptFile%,Interface,btn_AdvancedOptions,"Show Advanced Options"
End

WriteInterface,Visible,%ScriptFile%,Interface,bvl_CustomCmd,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,lbl_CustomCommandsHelp,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_Custom_Item1_Enabled,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item1_Cmd,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item1_Label,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_Custom_Item2_Enabled,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item2_Cmd,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item2_Label,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_Custom_Item3_Enabled,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item3_Cmd,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item3_Label,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_Custom_Item4_Enabled,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item4_Cmd,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item4_Label,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_Custom_Item5_Enabled,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item5_Cmd,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item5_Label,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_Custom_Item6_Enabled,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item6_Cmd,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,txt_Custom_Item6_Label,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,bvl_AdvancedOptions,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_UseCustomXMLCfg,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cb_DebugLog,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,fb_CustomXMLCfg,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,lbl_CustomXMLHelp,%Toggle%

System,EndLocal

[#ShowScriptInfo#]
// ===============================================================================================================================
// Name...........: ShowScriptInfo
// Description....: 
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
