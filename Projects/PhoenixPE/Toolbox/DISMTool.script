[Main]
Title=DISM Tool
Author=Homes32
Description=(v2.9.0) A GUI interface for DISM.
Version=1.0.2.0
Level=10
Selected=None
Date=2024-12-29
Mandatory=False

[Variables]
%ProgramFolder%=DISM_Tool
%ProgramExe%="DISM_Tool.exe"

[Process]
Echo,"This script cannot be processed directly."

[#LaunchProgram#]
// ===============================================================================================================================
// Name...........: LaunchProgram
// Description....: Launch GImageX
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........:
// ===============================================================================================================================
[LaunchProgram]
ExtractAllFiles,%ScriptFile%,DISM_Tool,"%ProjectTemp%\%ProgramFolder%"
ShellExecuteEx,Open,%ProgramExe%,"","%ProjectTemp%\%ProgramFolder%"

[#Interface#]
// ===============================================================================================================================
// Name...........: Interface
// Description....: 
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........:
// ===============================================================================================================================
[Interface]
btn_Launch=Launch,1,8,5,5,81,25,LaunchProgram,play-hot.png,True
web_Homepage=HomePage,1,10,318,10,55,18,https://www.pcassistsoftware.co.uk/free.html
bvb_Homepage=bvb_Homepage,1,12,308,5,72,24

