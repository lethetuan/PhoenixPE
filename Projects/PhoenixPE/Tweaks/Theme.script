[Main]
Title=Theme
Author=Homes32
Description=Customize the theme and window colors.
Version=1.2.1.0
Selected=True
Mandatory=False
Date=2024-01-14
Level=4

[Variables]

[Process]
Echo,"Processing %ScriptTitle%..."

RunFromRam

RegHiveLoad,Tmp_Default,%RegDefault%
RegHiveLoad,Tmp_Software,%RegSoftware%

If,%cb_UXPatch%,Equal,True,Run,%ScriptFile%,UXPatch

// Select Theme
If,%cmb_Theme%,Equal,"Default",Echo,"Using Default Theme"
Else,If,%cmb_Theme%,Equal,"Annihilator",Run,%ScriptFile%,Theme-Annihilator
Else,If,%cmb_Theme%,Equal,"Nocturnal",Run,%ScriptFile%,Theme-Nocturnal
Else,If,%cmb_Theme%,Equal,"Custom",Run,%ScriptFile%,Theme-Custom
Else,Halt,"INTERNAL LOGIC ERROR: [%cmb_Theme%] is not a valid theme."

Run,%ScriptFile%,ColorMeBadd

// Dark/Light Mode
If,%cmb_AppThemeMode%,Equal,"Dark",RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","AppsUseLightTheme",0
Else,If,%cmb_AppThemeMode%,Equal,"Light",RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","AppsUseLightTheme",1
Else,Halt,"INTERNAL LOGIC ERROR: [%cmb_AppThemeMode%] is not a valid App Theme Mode"

If,%cmb_SystemThemeMode%,Equal,"Dark",RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","SystemUsesLightTheme",0
Else,If,%cmb_SystemThemeMode%,Equal,"Light",RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","SystemUsesLightTheme",1
Else,Halt,"INTERNAL LOGIC ERROR: [%cmb_SystemThemeMode%] is not a valid System Theme Mode"

// Transparency Effects
If,%cb_TransparencyEffects%,Equal,True,RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","EnableTransparency",1
Else,RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","EnableTransparency",0

RegHiveUnLoad,Tmp_Default
RegHiveUnLoad,Tmp_Software

[#Theme-Annihilator#]
// ===============================================================================================================================
// Name...........: Theme-Annihilator
// Description....: Annihilator Theme - Author: Mr. GRiM (https://virtualcustoms.net/showthread.php/77576-Annihilator-Theme-for-Windows-10-Creators-April-2018-Update)
// Syntax.........: Run,%ScriptFile%,Theme-Annihilator
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: Requires UXPatch
// Related........: 
// ===============================================================================================================================
[Theme-Annihilator]
Echo,"Applying Annihilator Theme..."

ExtractFile,%ScriptFile%,Themes,Annihilator.7z,%ProjectTemp%
Decompress,"%ProjectTemp%\Annihilator.7z","%TargetWindows%\resources\themes\"
FileCopy,"%TargetWindows%\resources\themes\Annihilator\Backgrounds\Grungy_1920 x 1200.jpg","%TargetWindows%\Web\Wallpaper\Windows\img0.jpg"

RegWrite,HKLM,REG_EXPAND_SZ,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\ThemeManager","DllName","%SystemRoot%\resources\Themes\Annihilator\Annihilator.msstyles"
RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes","CurrentTheme","%SystemRoot%\resources\Themes\Annihilator.theme"
RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes","InstallTheme","%SystemRoot%\resources\Themes\Annihilator.theme"
RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes","InstallVisualStyle","%SystemRoot%\resources\Themes\Annihilator\Annihilator.msstyles"

RegWrite,HKLM,REG_DWORD,"Tmp_Default\SOFTWARE\Microsoft\Windows\DWM","ColorizationColor",253237532
RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","AppsUseLightTheme",0

AddAutoRun,PreShell,Wait,"Applying Annihilator Theme...","%SystemRoot%\resources\Themes\Annihilator.theme"

// StartIsBack
If,ExistDir,"%TargetPrograms%\StartIsBack\Orbs",Begin
  //ExtractFile,%FileContainer%,Themes,Annihilator.png,"%TargetPrograms%\StartIsBack\Orbs"
  //RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\StartIsBack","OrbBitmap","X:\Program Files\StartIsBack\Orbs\Annihilator.png"
End

// Open-Shell
If,ExistDir,"%TargetPrograms%\Open-Shell\Skins",Begin
  //ExtractFile,%ScriptFile%,Theme-Annihilator,Annihilator.png,"%TargetPrograms%\Open-Shell\Skins"
  //RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonPath","X:\Program Files\Open-Shell\Skins\Annihilator.png"
  //RegWrite,HKLM,REG_SZ,"Tmp_Default\Software\OpenShell\StartMenu\Settings","StartButtonType","CustomButton"
  //RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\OpenShell\StartMenu\Settings","EnableStartButton",1
End

[#Theme-Custom#]
// ===============================================================================================================================
// Name...........: Theme-Custom
// Description....: 
// Syntax.........: Run,%ScriptFile%,Theme-Custom
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: Requires UXPatch
// Related........: 
// ===============================================================================================================================
[Theme-Custom]
Echo,"Applying Custom Theme..."
If,Not,ExistFile,%fb_CustomTheme%,Halt,"Error: The specified theme file does not exist!"
StrFormat,EXT,%fb_CustomTheme%,%FileExt%
If,Not,%FileExt%,Equal,".msstyles",Halt,"Error: The theme must be an .msstyles file!"
Set,%FileExt%,Nil  
FileCopy,%fb_CustomTheme%,"%TargetWindows%\resources\themes\aero\aero.msstyles"

[#Theme-Nocturnal#]
// ===============================================================================================================================
// Name...........: Theme-Nocturnal
// Description....: 
// Syntax.........: Run,%ScriptFile%,Theme-Nocturnal
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: Requires UXPatch
// Related........: 
// ===============================================================================================================================
[Theme-Nocturnal]
Echo,"Applying Nocturnal Theme..."
ExtractFile,%ScriptFile%,Themes,Nocturnal.7z,%ProjectTemp%
Decompress,"%ProjectTemp%\Nocturnal.7z","%TargetWindows%\resources\themes\aero"
RegWrite,HKLM,REG_DWORD,"Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize","AppsUseLightTheme",0

[#UXPatch#]
// ===============================================================================================================================
// Name...........: UXPatch
// Description....: Patch the necessary .dll files to bypass .msstyles signature check
// Syntax.........: Run,%ScriptFile%,UXPatch
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: Depends on UXPatch.exe extracted from the script's attachments.
//                  UXPatch.exe (v1.10) is developed by JFX. (https://old.theoven.org/index78dd.html?topic=2768.0)
// Related........: %cb_UXPatch%
// ===============================================================================================================================
[UXPatch]
Echo,"Patching theme files to bypass signature check..."
ExtractFile,%ScriptFile%,Tools,UxPatch-%HostArch%.exe,%ProjectTemp%
ShellExecute,Hide,"%ProjectTemp%\UxPatch-%HostArch%.exe","P %TargetSystem32%\themeui.dll %TargetSystem32%\UXInit.dll %TargetSystem32%\uxtheme.dll"
If,%ExitCode%,Equal,1,Echo,"Theme signature check has been bypassed."
Else,Echo,"Theme signature check bypass: One or more files could not be patched. Check the build log for details.",Warn

[#ColorMeBadd#]
// ===============================================================================================================================
// Name...........: ColorMeBadd
// Description....: Set the color profile based on the script config. (All For You...)
// Syntax.........: Run,%ScriptFile%,ColorMeBadd
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........:  %cmb_ColorProfile%
// ===============================================================================================================================
[ColorMeBadd]
Echo,"Setting color profile to [%cmb_ColorProfile%]..."

// Configure some basic settings

// Turn of AutoColorization. We will turn this on again later if the user selects Auto.
RegWrite,HKLM,REG_DWORD,"Tmp_Default\Control Panel\Desktop",AutoColorization,0
RegWrite,HKLM,REG_DWORD,Tmp_Default\Software\Microsoft\Windows\DWM,ColorizationGlassAttribute,0
//RegWrite,HKLM,REG_DWORD,Tmp_Default\Software\Microsoft\Windows\DWM,ColorPrevalence,0
RegWrite,HKLM,REG_DWORD,Tmp_Default\SOFTWARE\Microsoft\Windows\DWM,Composition,1
//RegWrite,HKLM,REG_DWORD,Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize,ColorPrevalence,0
RegWrite,HKLM,REG_DWORD,Tmp_Default\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize,EnableTransparency,1

If,%cmb_ColorProfile%,Equal,"Auto",Begin
  // Auto select a color profile based on the background color/image
  RegWrite,HKLM,REG_DWORD,"Tmp_Default\Control Panel\Desktop","AutoColorization",1
  AddVariables,%ScriptFile%,ColorProfile-Default Blue
End
Else,If,%cmb_ColorProfile%,Equal,"Host Color Profile",Begin
  // Use the color profile from the Host OS
  Run,%ScriptFile%,ReadHostColorProfile
End
Else,If,%cmb_ColorProfile%,Equal,"Custom",Begin
  // User defined color profile.
  // No validation is performed. The user is expected to provide valid input or face the consequences.
  Set,%StartColorMenu%,%txt_StartMenuColor%
  Set,%AccentColorMenu%,%txt_AccentColorMenu%
  Set,%AccentColor%,%txt_AccentColor%
  Set,%ColorizationColor%,%txt_ColorizationColor%
  Set,%ColorizationAfterglow%,%txt_ColorizationAfterglow%
  Set,%AccentPalette%,%txt_AccentPalette%
End
Else,Begin
  // Use a color preset
  AddVariables,%ScriptFile%,ColorProfile-%cmb_ColorProfile%
End

// Write our Color Config if we are using Host Profile or Custom
RegWrite,HKLM,REG_DWORD,"Tmp_Default\SOFTWARE\Microsoft\Windows\DWM","AccentColor",%AccentColor%
RegWrite,HKLM,REG_DWORD,"Tmp_Default\SOFTWARE\Microsoft\Windows\DWM","ColorizationColor",%ColorizationColor%
RegWrite,HKLM,REG_DWORD,"Tmp_Default\SOFTWARE\Microsoft\Windows\DWM","ColorizationAfterglow",%ColorizationAfterglow%
RegWrite,HKLM,REG_BINARY,"Tmp_Default\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Accent","AccentPalette",%AccentPalette%
RegWrite,HKLM,REG_DWORD,"Tmp_Default\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Accent","StartColorMenu",%StartColorMenu%
RegWrite,HKLM,REG_DWORD,"Tmp_Default\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Accent","AccentColorMenu",%AccentColorMenu%

[#ImportHostColorProfile#]
// ===============================================================================================================================
// Name...........: ImportHostColorProfile
// Description....: Import the Color Profile used by the local host system and populate the script interface config
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_ImportHostColorProfile
// ===============================================================================================================================
[ImportHostColorProfile]
Run,%ScriptFile%,ReadHostColorProfile

WriteInterface,Value,%ScriptFile%,Interface,txt_StartMenuColor,%StartColorMenu%
WriteInterface,Value,%ScriptFile%,Interface,txt_AccentColorMenu,%AccentColorMenu%
WriteInterface,Value,%ScriptFile%,Interface,txt_AccentColor,%AccentColor%
WriteInterface,Value,%ScriptFile%,Interface,txt_ColorizationColor,%ColorizationColor%
WriteInterface,Value,%ScriptFile%,Interface,txt_ColorizationAfterglow,%ColorizationAfterglow%
WriteInterface,Value,%ScriptFile%,Interface,txt_AccentPalette,%AccentPalette%

[#ReadHostColorProfile#]
// ===============================================================================================================================
// Name...........: ReadHostColorProfile
// Description....: Import the Color Profile used by the local host system.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: ImportHostColorProfile, cmb_ColorProfile, btn_ImportHostColorProfile
// ===============================================================================================================================
[ReadHostColorProfile]
RegRead,HKCU,"SOFTWARE\Microsoft\Windows\DWM","AccentColor",%AccentColor%
RegRead,HKCU,"SOFTWARE\Microsoft\Windows\DWM","ColorizationColor",%ColorizationColor%
RegRead,HKCU,"SOFTWARE\Microsoft\Windows\DWM","ColorizationAfterglow",%ColorizationAfterglow%
RegRead,HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Accent","AccentPalette",%AccentPalette%
RegRead,HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Accent","StartColorMenu",%StartColorMenu%
RegRead,HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Accent","AccentColorMenu",%AccentColorMenu%

[#ColorProfiles#]
